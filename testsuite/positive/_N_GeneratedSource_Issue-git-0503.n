// X
protected virtual EqualsImpl(other : X.[]) : bool
{
  _  = other;
  match (other)
    {
    | null => 
      false
    | _  => 
      true
  }
}

// X
public Equals(other : X.[]) : bool
{
  EqualsImpl(other)
}

// X
public override Equals(other : System.Object) : boolmatch (other)
{
  | (x is X.[]) => 
    EqualsImpl(x)
  | _  => 
    false
}

// X
public override GetHashCode() : int
{
  0
}

// X.A
protected virtual EqualsImpl(other : X.A) : bool
{
  _  = other;
  match (other)
    {
    | null => 
      false
    | _  => 
      this.other == other.other && base.EqualsImpl((other : X))
  }
}

// X.A
public Equals(other : X.A.[]) : bool
{
  EqualsImpl(other)
}

// X.A
protected override EqualsImpl(other : X) : boolmatch (other)
{
  | (x is X.A.[]) => 
    EqualsImpl(x)
  | _  => 
    false
}

// X.A
public override Equals(other : System.Object) : boolmatch (other)
{
  | (x is X.A.[]) => 
    EqualsImpl(x)
  | _  => 
    false
}

// X.A
public override GetHashCode() : int
{
  unchecked 
  {
    mutable (hash : int);
    
    {
      
      {
        hash += other;
        hash += hash << 10;
        hash ^= hash >> 6
      }
    };
    hash ^= base.GetHashCode();
    hash ^= 1;
    hash
  }
}

// X.B
protected virtual EqualsImpl(other : X.B) : bool
{
  _  = other;
  match (other)
    {
    | null => 
      false
    | _  => 
      base.EqualsImpl((other : X))
  }
}

// X.B
public Equals(other : X.B.[]) : bool
{
  EqualsImpl(other)
}

// X.B
protected override EqualsImpl(other : X) : boolmatch (other)
{
  | (x is X.B.[]) => 
    EqualsImpl(x)
  | _  => 
    false
}

// X.B
public override Equals(other : System.Object) : boolmatch (other)
{
  | (x is X.B.[]) => 
    EqualsImpl(x)
  | _  => 
    false
}

// X.B
public override GetHashCode() : int
{
  base.GetHashCode()
}

