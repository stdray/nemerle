using Nemerle.Compiler;
using Nemerle.Completion2;
using Nemerle.Compiler.Utils.Async;

using System;
using System.Collections.Generic;
using System.IO;

namespace Nemerle.Completion2
{
  public class EngineBridge
  {
    private mutable _engine   : Engine;
    private mutable _project  : LspIdeProject;
    private mutable _ready    : bool;

    public Ready : bool { get { _ready } }
    public Project : LspIdeProject { get { _project } }

    public Initialize(project : LspIdeProject) : void
    {
      _project = project;
      _engine = Engine(_project, TextWriter.Null, false);
      _ready = true;
    }

    public AddOrUpdateDocument(uri : string, text : string, version : int) : void
    {
      when (_ready)
      {
        def idx = _project.AddOrUpdateSource(uri, text, version);
        def src = _project.GetSource(idx) :> IIdeSource;
        def request = _engine.BeginUpdateCompileUnit(src, null);
        _ = request.AsyncWaitHandle.WaitOne(5000);
      }
    }

    public RemoveDocument(uri : string) : void
    {
      when (_ready)
      {
        try
        {
          def src = _project.FindByUri(uri);
          _project.RemoveSource(uri);
          _engine.NotifySourceDeleted(src.FileIndex)
        }
        catch { _ => () }
      }
    }

    public GetDiagnostics(uri : string) : array[string]
    {
      _project.GetDiagnosticStrings(uri).ToArray()
    }

    public DebugDumpSources() : void
    {
      def path = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "nemerle-lsp-sources.txt");
      using (def w = System.IO.StreamWriter(path, false)) { _project.DumpSources(w) }
    }

    public RebuildProject() : void
    {
      when (_ready)
      {
        def req = _engine.BeginReloadProject();
        when (req != null)
          _ = req.AsyncWaitHandle.WaitOne(60000)
      }
    }

    public Shutdown() : void
    {
      when (_ready)
      {
        _ready = false;
        _engine.Close()
      }
    }

    private FindSource(uri : string) : IIdeSource
    {
      _project.FindByUri(uri) :> IIdeSource
    }

    public Complete(uri : string, line : int, col : int) : array[CompletionElem]
    {
      if (_ready)
      {
        def src = FindSource(uri);
        if (src != null)
        {
          def snap = src.GetSourceSnapshot();
          def lc = LineColumn(line + 1, col + 1);
          def pos = snap.LineColumnToPosition(lc);
          def location = Location(snap, pos);
          try
          {
            def request = _engine.Completion(src, location, false);
            request.CompletionResult.CompletionList
          }
          catch { _ => array(0) }
        }
        else array(0)
      }
      else array(0)
    }

    public GetDefinitions(uri : string, line : int, col : int) : array[GotoInfo]
    {
      if (_ready)
      {
        def src = FindSource(uri);
        if (src != null)
        {
          def snap = src.GetSourceSnapshot();
          def lc = LineColumn(line + 1, col + 1);
          def pos = snap.LineColumnToPosition(lc);
          def location = Location(snap, pos);
          try { _engine.GetGotoInfo(src, location, GotoKind.Definition) }
          catch { _ => array(0) }
        }
        else array(0)
      }
      else array(0)
    }

    public GetHoverText(uri : string, line : int, col : int) : string
    {
      if (_ready)
      {
        def src = FindSource(uri);
        if (src != null)
        {
          def snap = src.GetSourceSnapshot();
          def lc = LineColumn(line + 1, col + 1);
          def pos = snap.LineColumnToPosition(lc);
          def location = Location(snap, pos);
          try
          {
            def request = _engine.BeginGetQuickTipInfo(src, location);
            _ = request.AsyncWaitHandle.WaitOne(10000);
            if (request.QuickTipInfo != null) request.QuickTipInfo.Text else "error:null_tip"
          }
          catch { e => "error:" + e.Message }
        }
        else "error:no_source"
      }
      else "error:not_ready"
    }

    public GetMethodTip(uri : string, line : int, col : int) : MethodTipInfo
    {
      if (_ready)
      {
        def src = FindSource(uri);
        if (src != null)
        {
          def snap = src.GetSourceSnapshot();
          def lc = LineColumn(line + 1, col + 1);
          def pos = snap.LineColumnToPosition(lc);
          def location = Location(snap, pos);
          try
          {
            def request = _engine.BeginGetMethodTipInfo(src, location);
            _ = request.AsyncWaitHandle.WaitOne(5000);
            request.MethodTipInfo
          }
          catch { _ => null }
        }
        else null
      }
      else null
    }

    public GetFileUri(fileIndex : int) : string
    {
      if (_ready)
      {
        try
        {
          def src = _project.GetSource(fileIndex);
          if (src : object is LspIdeSource)
            (src :> LspIdeSource).Uri
          else
            ""
        }
        catch { _ => "" }
      }
      else ""
    }
  }
}
