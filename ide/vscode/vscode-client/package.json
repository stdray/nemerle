{
  "name": "nemerle-vscode",
  "displayName": "Nemerle Language Support",
  "description": "Nemerle language support for Visual Studio Code (LSP-based)",
  "version": "0.1.0",
  "publisher": "nemerle",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:nemerle"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nemerle",
        "aliases": ["Nemerle", "nemerle"],
        "extensions": [".n"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nemerle",
        "scopeName": "source.nemerle",
        "path": "./syntaxes/nemerle.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nemerle",
        "path": "./snippets/nemerle.json"
      }
    ],
    "configuration": {
      "title": "Nemerle",
      "properties": {
        "nemerle.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to nemerle-language-server executable or DLL. Leave empty to auto-detect."
        },
        "nemerle.server.dotnetArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments to pass to dotnet when launching the server."
        },
        "nemerle.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VSCode and the language server."
        }
      }
    },
    "commands": [
      { "command": "nemerle.compile", "title": "Compile current file", "category": "Nemerle" },
      { "command": "nemerle.compileRun", "title": "Compile and Run current file", "category": "Nemerle" }
    ],
    "keybindings": [
      { "command": "nemerle.compile", "key": "ctrl+shift+b", "when": "editorLangId == nemerle" },
      { "command": "nemerle.compileRun", "key": "f5", "when": "editorLangId == nemerle" },
      { "command": "nemerle.compileRun", "key": "ctrl+f5", "when": "editorLangId == nemerle" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun compile",
    "compile": "bunx tsc -p ./",
    "watch": "bunx tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
