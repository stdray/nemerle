using Nemerle;
using Nemerle.Compiler;
using Nemerle.Compiler.Parsetree;

namespace VscodeTestMacro
{
  /// <summary>
  /// Adds a Greet() method that returns a greeting string.
  /// Usage: [Greet("Hello")]
  /// </summary>
  [MacroUsage(MacroPhase.BeforeInheritance, MacroTargets.Class,
    Inherited = true, AllowMultiple = false)]
  macro Greet(tb : TypeBuilder, name : string)
  {
    def greeting = name;
    def body = <[ $"$greeting from $(this.GetType())!" ]>;
    def method = <[ decl:
      public Greet() : string { $body }
    ]>;
    tb.Define(method);
  }

  /// <summary>
  /// Logs a message at compile time.
  /// Usage: [LogCompile("Processing type")]
  /// </summary>
  [MacroUsage(MacroPhase.BeforeInheritance, MacroTargets.Class,
    Inherited = true, AllowMultiple = true)]
  macro LogCompile(tb : TypeBuilder, message : string)
  {
    Nemerle.IO.printf("Compile-time: %s\n", message);
  }
}
