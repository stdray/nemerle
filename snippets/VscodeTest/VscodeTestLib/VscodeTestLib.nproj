<Project>
  <PropertyGroup>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(MSBuildProjectDirectory)\..\..\..\boot</Nemerle>
    <OutputType>Library</OutputType>
    <AssemblyName>VscodeTestLib</AssemblyName>
    <NoStdLib>true</NoStdLib>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" />
  <ItemGroup><Compile Include="*.n" /></ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" />
</Project>
