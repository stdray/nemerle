<Project>
  <PropertyGroup>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(USERPROFILE)\.nuget\packages\stdray.nemerle.compiler\1.3.0-rc.10352\build</Nemerle>
    <OutputType>Exe</OutputType>
    <AssemblyName>VscodeTestApp</AssemblyName>
    <NoStdLib>true</NoStdLib>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" />
  <ItemGroup>
    <Compile Include="*.n" />
    <Reference Include="Nemerle" />
    <PackageReference Include="stdray.Nemerle.Compiler" Version="1.3.0-rc.10352" />
    <ProjectReference Include="..\VscodeTestLib\VscodeTestLib.nproj">
      <Name>VscodeTestLib</Name>
    </ProjectReference>
    <MacroProjectReference Include="..\VscodeTestMacro\VscodeTestMacro.nproj">
      <Name>VscodeTestMacro</Name>
    </MacroProjectReference>
  </ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" />
</Project>
