using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Logging.Abstractions;

namespace Nemerle.Compiler
{
  public module CompilerLog
  {
    private mutable _log : ILogger = NullLogger.Instance;

    public InitLogger(logger : ILogger) : void
    {
      _log = logger
    }

    public LogDebug(message : string) : void
    {
      LoggerExtensions.LogDebug(_log, message);
    }

    public LogDebug(message : string, arg0 : object) : void
    {
      LoggerExtensions.LogDebug(_log, message, arg0);
    }

    public LogDebug(message : string, arg0 : object, arg1 : object) : void
    {
      LoggerExtensions.LogDebug(_log, message, arg0, arg1);
    }

    public LogDebug(message : string, arg0 : object, arg1 : object, arg2 : object) : void
    {
      LoggerExtensions.LogDebug(_log, message, arg0, arg1, arg2);
    }

    public LogInformation(message : string) : void
    {
      LoggerExtensions.LogInformation(_log, message);
    }

    public LogInformation(message : string, arg0 : object) : void
    {
      LoggerExtensions.LogInformation(_log, message, arg0);
    }

    public LogWarning(message : string) : void
    {
      LoggerExtensions.LogWarning(_log, message);
    }

    public LogWarning(message : string, arg0 : object) : void
    {
      LoggerExtensions.LogWarning(_log, message, arg0);
    }

    public LogError(message : string) : void
    {
      LoggerExtensions.LogError(_log, message);
    }

    public LogError(message : string, arg0 : object) : void
    {
      LoggerExtensions.LogError(_log, message, arg0);
    }

    public LogError(message : string, arg0 : object, arg1 : object) : void
    {
      LoggerExtensions.LogError(_log, message, arg0, arg1);
    }
  }
}
