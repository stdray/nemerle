<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>NU5100;NU5128;NU5129;NU5017</NoWarn>
    <PackageId>stdray.Nemerle.Compiler</PackageId>
    <Description>Nemerle compiler, standard library, macros, and MSBuild SDK</Description>
    <Authors>Nemerle Project</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Stage3 content defaults (Cake overrides these) -->
  <PropertyGroup>
    <Stage3Dir Condition="'$(Stage3Dir)' == ''">$(MSBuildProjectDirectory)\..\..\bin\Release\Stage3</Stage3Dir>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildProjectDirectory)\..\..</RepoRoot>
    <MSBuildTaskOutput Condition="'$(MSBuildTaskOutput)' == ''">$(Stage3Dir)</MSBuildTaskOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- lib/netstandard2.0 — compiler DLLs for PackageReference consumers -->
    <Content Include="$(Stage3Dir)\Nemerle.dll"             PackagePath="lib\netstandard2.0\" />
    <Content Include="$(Stage3Dir)\Nemerle.Compiler.dll"    PackagePath="lib\netstandard2.0\" />
    <Content Include="$(Stage3Dir)\Nemerle.Macros.dll"      PackagePath="lib\netstandard2.0\" />
    <Content Include="$(Stage3Dir)\dnlib.dll"               PackagePath="lib\netstandard2.0\" />

    <!-- build/ — MSBuild SDK for .nproj auto-import -->
    <Content Include="$(RepoRoot)\sdk/Nemerle.Sdk.props"       PackagePath="build\" />
    <Content Include="$(RepoRoot)\sdk/Nemerle.Sdk.targets"     PackagePath="build\" />
    <Content Include="$(RepoRoot)\sdk/Nemerle.MSBuild.targets" PackagePath="build\" />
    <Content Include="$(MSBuildTaskOutput)\Nemerle.MSBuild.Tasks.dll"         PackagePath="build\" />
    <Content Include="$(Stage3Dir)\ncc-core.dll"              PackagePath="build\" />
    <Content Include="$(Stage3Dir)\ncc-core.runtimeconfig.json" PackagePath="build\" />

    <!-- buildTransitive/ — for transitive NuGet SDK flow -->
    <Content Include="$(RepoRoot)\sdk/Nemerle.Sdk.props"       PackagePath="buildTransitive\" />
    <Content Include="$(RepoRoot)\sdk/Nemerle.Sdk.targets"     PackagePath="buildTransitive\" />
    <Content Include="$(RepoRoot)\sdk/Nemerle.MSBuild.targets" PackagePath="buildTransitive\" />

    <!-- tools/net8.0 — ncc-core command-line compiler -->
    <Content Include="$(Stage3Dir)\ncc-core.dll"              PackagePath="tools\net8.0\" />
    <Content Include="$(Stage3Dir)\ncc-core.runtimeconfig.json" PackagePath="tools\net8.0\" />
  </ItemGroup>

  <!-- dnlib is a dependency of the package -->
  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>
</Project>
